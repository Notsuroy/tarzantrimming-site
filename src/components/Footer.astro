---
import site from '~/data/site.json';

const year = new Date().getFullYear();
---

<footer class="bg-forest text-cream/90 mt-20">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid md:grid-cols-3 gap-10">
      <div>
        <div class="font-display text-2xl text-cream">{site.brand.wordmark}</div>
        <p class="mt-3 text-sm text-cream/70 leading-relaxed max-w-xs">{site.brand.shortDescription}</p>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-widest2 text-cream/60 mb-3">Get in touch</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`tel:${site.contact.phoneE164}`} class="hover:text-cream">{site.contact.phoneDisplay}</a></li>
          <li><a href={`sms:${site.contact.phoneE164}`} class="hover:text-cream">Send a text</a></li>
          {site.contact.email && !site.contact.email.startsWith('TODO') && (
            <li><a href={`mailto:${site.contact.email}`} class="hover:text-cream">{site.contact.email}</a></li>
          )}
        </ul>
      </div>

      <div>
        <h3 class="text-xs uppercase tracking-widest2 text-cream/60 mb-3">Service area</h3>
        <p class="text-sm text-cream/70 leading-relaxed">{site.location.serviceAreaLabel}, including {site.serviceCities.map(c => c.name).join(', ')}.</p>
        <p class="mt-3 text-sm text-cream/60">{site.hours.label}</p>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-cream/15 text-xs text-cream/50 flex flex-wrap items-center justify-between gap-3">
      <span>© {year} {site.brand.name}</span>
      <span>{site.location.serviceAreaLabel} · {site.location.province}</span>
    </div>
  </div>
</footer>
