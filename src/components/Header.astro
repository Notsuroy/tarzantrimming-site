---
import site from '~/data/site.json';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const nav = [
  { href: '/',               label: 'Home' },
  { href: '/services/',      label: 'Services' },
  { href: '/service-areas/', label: 'Service Areas' },
  { href: '/about/',         label: 'About' },
  { href: '/contact/',       label: 'Contact' },
];

const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const hasPhone = !!site.contact.phoneE164;
---

<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-cream-deep">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-18">
      <a href="/" class="flex items-baseline gap-2 group">
        <span class="font-display text-2xl md:text-3xl text-forest tracking-tight group-hover:text-forest-dark transition-colors">{site.brand.wordmark}</span>
      </a>

      <nav class="hidden md:flex items-center gap-7">
        {nav.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium tracking-wide transition-colors ${isActive(item.href) ? 'text-forest' : 'text-ink-muted hover:text-forest'}`}
          >{item.label}</a>
        ))}
        {hasPhone ? (
          <a
            href={`tel:${site.contact.phoneE164}`}
            class="inline-flex items-center gap-2 px-4 py-2 bg-forest text-cream rounded-full text-sm font-medium hover:bg-forest-dark transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h2.28a2 2 0 011.94 1.515l.7 2.8a2 2 0 01-1.107 2.281l-.84.42a11.05 11.05 0 005.516 5.516l.42-.84a2 2 0 012.282-1.106l2.8.7A2 2 0 0121 17.72V20a2 2 0 01-2 2h-1C9.716 22 2 14.284 2 5V4a1 1 0 011-1h0"></path></svg>
            {site.contact.phoneDisplay}
          </a>
        ) : (
          <a href="/contact/" class="inline-flex items-center px-4 py-2 bg-forest text-cream rounded-full text-sm font-medium hover:bg-forest-dark transition-colors">
            Get in touch
          </a>
        )}
      </nav>

      <details class="md:hidden relative">
        <summary class="list-none cursor-pointer p-2 -mr-2 text-forest" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-56 bg-cream border border-cream-deep rounded-lg shadow-card py-2">
          {nav.map((item) => (
            <a href={item.href} class={`block px-4 py-2 text-sm ${isActive(item.href) ? 'text-forest font-medium' : 'text-ink-muted hover:text-forest hover:bg-cream-dark'}`}>{item.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
