---
// Placeholder gallery. Friend to send before/after pruning shots.
// Once photos land in /public/photos/, replace the placeholder grid with real <picture> tags.
const placeholders = Array.from({ length: 6 });
---

<section class="py-16 md:py-24 bg-cream-dark">
  <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-narrow mb-12">
      <div class="text-xs uppercase tracking-widest2 text-bark mb-3">Recent work</div>
      <h2 class="font-display text-3xl md:text-4xl text-forest leading-tight">Before-and-after from the south Ontario service area.</h2>
      <p class="mt-4 text-ink-muted">Photos coming as the first jobs land. If your tree is in here, that means we did the work.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
      {placeholders.map((_, i) => (
        <div class="aspect-square bg-gradient-to-br from-forest/30 via-moss/30 to-bark/30 rounded-xl flex items-center justify-center text-cream/60 text-sm">
          [photo {i + 1}]
        </div>
      ))}
    </div>
  </div>
</section>
