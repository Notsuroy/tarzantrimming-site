---
import reviews from '~/data/reviews.json';

const items = reviews.items || [];
const show = reviews.showOnHomepage && items.length > 0;
---

{show && (
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-narrow mx-auto text-center mb-12">
        <div class="text-xs uppercase tracking-widest2 text-forest mb-3">What customers say</div>
        <h2 class="font-display text-3xl md:text-4xl text-forest leading-tight">Words from real south Ontario homeowners.</h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map((r) => (
          <figure class="bg-white border border-cream-deep rounded-2xl p-6 shadow-card">
            <blockquote class="text-ink leading-relaxed">"{r.text}"</blockquote>
            <figcaption class="mt-4 text-sm text-ink-muted">
              <span class="font-medium text-forest">{r.name}</span>
              {r.city && <span>, {r.city}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
