---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import site from '~/data/site.json';
import blog from '~/data/blog.json';
import servicesData from '~/data/services.json';

export function getStaticPaths() {
  return blog.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const path = `/blog/${post.slug}/`;

// Sibling posts for cross-linking. Wrap around the array so every post gets up
// to two inbound links from siblings without always picking the same two. Guards
// keep it correct when the corpus is tiny (1 or 2 posts).
const idx = blog.findIndex((p) => p.slug === post.slug);
const otherPosts =
  blog.length > 1
    ? [blog[(idx + 1) % blog.length], blog[(idx + 2) % blog.length]].filter(
        (p) => p && p.slug !== post.slug,
      )
    : [];

// Related services: funnel link equity from the post to the commercial service
// pages. Use curated post.relatedServices slugs if present, else fall back to
// all offered services (the site only offers two, so this is naturally short).
const offered = servicesData.services.filter((s) => !s.comingSoon);
const bySlug = (slug: string) => offered.find((s) => s.slug === slug);
const curated = ((post.relatedServices as string[] | undefined) || [])
  .map(bySlug)
  .filter(Boolean) as { slug: string; name: string; tagline: string }[];
const related = (curated.length ? curated : offered).slice(0, 3);

const wordCount = (
  post.intro +
  ' ' +
  post.sections.map((s: { paragraphs: string[] }) => s.paragraphs.join(' ')).join(' ')
)
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;

const readMinutes = parseInt((post.readTime || '').match(/\d+/)?.[0] || '0', 10);

const articleLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.h1,
  description: post.description,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt || post.publishedAt,
  url: new URL(path, Astro.site).toString(),
  mainEntityOfPage: new URL(path, Astro.site).toString(),
  inLanguage: 'en-CA',
  wordCount,
  ...(readMinutes > 0 ? { timeRequired: `PT${readMinutes}M` } : {}),
  image: {
    '@type': 'ImageObject',
    url: new URL('/photos/og-default.png', Astro.site).toString(),
    width: 1200,
    height: 630,
  },
  author: { '@type': 'Organization', name: site.brand.name, url: site.url },
  publisher: {
    '@type': 'LocalBusiness',
    name: site.brand.name,
    url: site.url,
    telephone: site.contact.phoneE164,
    areaServed: site.location.serviceAreaLabel,
    logo: {
      '@type': 'ImageObject',
      url: new URL('/favicon.svg', Astro.site).toString(),
    },
  },
  about: { '@type': 'Thing', name: post.focusKeyword },
  keywords: post.focusKeyword,
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/blog/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: post.h1, item: new URL(path, Astro.site).toString() },
  ],
};

const faqs = (post.faqs as { q: string; a: string }[] | undefined) || [];
const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
      })),
    }
  : null;
---
<BaseLayout title={post.title} description={post.description} path={path}>
  <article>
    <section class="py-16 md:py-20 bg-cream">
      <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="text-xs uppercase tracking-widest2 text-ink-muted mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-forest">Home</a>
          <span class="mx-2">/</span>
          <a href="/blog/" class="hover:text-forest">Guides</a>
          <span class="mx-2">/</span>
          <span class="text-forest">{post.h1}</span>
        </nav>
        <div class="max-w-narrow">
          <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Guide</div>
          <h1 class="font-display text-4xl md:text-5xl text-forest leading-tight">{post.h1}</h1>
          <div class="mt-4 text-ink-muted text-sm flex items-center gap-3">
            <span>{post.readTime} read</span>
            <span aria-hidden="true">·</span>
            <span>By {site.brand.name}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="py-12 md:py-16 bg-white">
      <div class="max-w-narrow mx-auto px-4 sm:px-6 lg:px-8 text-ink leading-relaxed">
        {post.intro.split(/\n\n+/).map((para: string) => (
          <p class="text-lg mb-5" set:html={para} />
        ))}

        {post.sections.map((section: { heading: string; paragraphs: string[] }) => (
          <div class="mt-10">
            <h2 class="font-display text-2xl md:text-3xl text-forest mb-4 leading-tight">{section.heading}</h2>
            {section.paragraphs.map((p) => <p class="mb-4" set:html={p} />)}
          </div>
        ))}

        <div class="bg-cream border-l-4 border-forest rounded-r-xl p-6 my-10">
          <h3 class="font-display text-xl text-forest mb-2">{post.ctaHeading || 'Want a straight answer on your tree?'}</h3>
          <p class="text-ink-muted mb-4" set:html={post.ctaCopy || 'Send a photo and your address through the contact page and we will tell you what the work involves and what it costs. No deposit, no pressure.'} />
          <div class="flex flex-wrap gap-3">
            <a href={`tel:${site.contact.phoneE164}`} class="inline-flex items-center px-4 py-2 bg-forest text-cream rounded-full text-sm font-medium hover:bg-forest-dark transition-colors">Call {site.contact.phoneDisplay}</a>
            <a href="/contact/" class="inline-flex items-center px-4 py-2 border border-forest text-forest rounded-full text-sm font-medium hover:bg-forest hover:text-cream transition-colors">Get a free quote</a>
          </div>
        </div>
      </div>
    </section>

    {faqs.length > 0 && (
      <section class="py-16 md:py-20 bg-cream border-t border-cream-deep" id="faq">
        <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-narrow mx-auto text-center mb-12">
            <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Common questions</div>
            <h2 class="font-display text-3xl md:text-4xl text-forest leading-tight">Questions homeowners ask</h2>
          </div>
          <div class="max-w-narrow mx-auto space-y-3">
            {faqs.map((item) => (
              <details class="group bg-white border border-cream-deep rounded-xl open:shadow-card transition-shadow">
                <summary class="cursor-pointer list-none px-6 py-5 flex items-start justify-between gap-4 font-medium text-ink">
                  <span>{item.q}</span>
                  <span class="text-forest text-2xl leading-none group-open:rotate-45 transition-transform shrink-0">+</span>
                </summary>
                <div class="px-6 pb-5 text-ink-muted leading-relaxed" set:html={item.a} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="py-14 md:py-16 bg-white border-t border-cream-deep">
        <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8 max-w-narrow">
          <h2 class="font-display text-2xl md:text-3xl text-forest mb-2">Tree services in south Ontario</h2>
          <p class="text-ink-muted mb-5">Rather have it handled? These are the services most relevant to this guide.</p>
          <ul class="space-y-2">
            {related.map((s) => (
              <li>
                <a href={`/services/${s.slug}/`} class="text-forest underline hover:text-forest-dark font-medium">{s.name}</a>
                <span class="text-ink-muted"> {s.tagline}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {otherPosts.length > 0 && (
      <section class="py-14 md:py-16 bg-cream border-t border-cream-deep">
        <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="font-display text-2xl md:text-3xl text-forest mb-8 text-center">Read more</h2>
          <div class="grid md:grid-cols-2 gap-6 max-w-narrow mx-auto">
            {otherPosts.map((p) => (
              <a href={`/blog/${p.slug}/`} class="group block bg-white border border-cream-deep rounded-xl p-6 hover:shadow-card hover:border-moss/60 transition-all">
                <div class="text-xs text-ink-muted mb-2">{p.readTime} read</div>
                <h3 class="font-display text-lg text-forest group-hover:text-forest-dark">{p.h1}</h3>
                <p class="text-ink-muted mt-2 text-sm leading-relaxed">{p.description}</p>
                <div class="mt-3 text-forest font-medium text-sm group-hover:underline">Read →</div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</BaseLayout>
