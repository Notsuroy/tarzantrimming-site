---
import BaseLayout from '~/layouts/BaseLayout.astro';
import site from '~/data/site.json';

const title = `Contact · ${site.brand.name}`;
const hasPhone = !!site.contact.phoneE164;
const hasEmail = !!site.contact.email && !site.contact.email.startsWith('TODO');
const hasAnyContact = hasPhone || hasEmail;
---
<BaseLayout title={title} path="/contact/">
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-narrow mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Contact</div>
      <h1 class="font-display text-4xl md:text-5xl text-forest leading-tight">
        {hasAnyContact ? 'Phone, text, or email. Pick whichever is easiest.' : 'Contact details going live shortly.'}
      </h1>

      {hasAnyContact ? (
        <div class="mt-10 grid sm:grid-cols-2 gap-6">
          {hasPhone && (
            <a href={`tel:${site.contact.phoneE164}`} class="block bg-white border border-cream-deep rounded-2xl p-6 shadow-card hover:shadow-soft transition-shadow">
              <div class="text-xs uppercase tracking-widest2 text-bark">Call</div>
              <div class="mt-2 font-display text-2xl text-forest">{site.contact.phoneDisplay}</div>
              <p class="mt-3 text-sm text-ink-muted">Fastest for actively dangerous situations. Goes to voicemail outside hours; we call back within the next business morning.</p>
            </a>
          )}

          {hasPhone && (
            <a href={`sms:${site.contact.phoneE164}`} class="block bg-white border border-cream-deep rounded-2xl p-6 shadow-card hover:shadow-soft transition-shadow">
              <div class="text-xs uppercase tracking-widest2 text-bark">Text</div>
              <div class="mt-2 font-display text-2xl text-forest">{site.contact.phoneDisplay}</div>
              <p class="mt-3 text-sm text-ink-muted">Send a photo of the tree, your address, and what you are thinking. We will reply with a ballpark.</p>
            </a>
          )}

          {hasEmail && (
            <a href={`mailto:${site.contact.email}`} class={`block bg-white border border-cream-deep rounded-2xl p-6 shadow-card hover:shadow-soft transition-shadow ${hasPhone ? 'sm:col-span-2' : ''}`}>
              <div class="text-xs uppercase tracking-widest2 text-bark">Email</div>
              <div class="mt-2 font-display text-2xl text-forest">{site.contact.email}</div>
            </a>
          )}
        </div>
      ) : (
        <div class="mt-10 bg-white border border-cream-deep rounded-2xl p-8 shadow-card">
          <p class="text-ink leading-relaxed">
            Tarzan Trimming is opening for residential pruning and limb removal across south Ontario shortly. Phone, text, and email channels are being set up. Bookmark this page, or check back in a few days.
          </p>
        </div>
      )}

      <div class="mt-12 bg-cream-dark rounded-2xl p-6">
        <h2 class="font-display text-xl text-forest mb-3">Service area</h2>
        <p class="text-ink leading-relaxed">{site.brand.shortDescription}</p>
        <p class="mt-3 text-sm text-ink-muted">{site.hours.label}</p>
      </div>
    </div>
  </section>
</BaseLayout>
