---
import BaseLayout from '~/layouts/BaseLayout.astro';
import site from '~/data/site.json';

const title = `Contact · ${site.brand.name}`;
const hasPhone = !!site.contact.phoneE164;
const hasEmail = !!site.contact.email && !site.contact.email.startsWith('TODO');
const hasAnyContact = hasPhone || hasEmail;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: new URL('/contact/', Astro.site).toString() },
  ],
};
---
<BaseLayout title={title} description="Reach Tarzan Trimming for owner-led tree pruning and limb removal in south Ontario. Get in touch for a free, no-pressure on-site quote today." path="/contact/">
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-narrow mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs uppercase tracking-widest2 text-ink-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-forest">Home</a>
        <span class="mx-2">/</span>
        <span class="text-forest">Contact</span>
      </nav>
      <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Contact</div>
      <h1 class="font-display text-4xl md:text-5xl text-forest leading-tight">
        {hasAnyContact ? (
          <Fragment>Phone, text, or email.<span class="block">Pick whichever is easiest.</span></Fragment>
        ) : 'Contact details going live shortly.'}
      </h1>

      {hasAnyContact ? (
        <div class="mt-10 grid sm:grid-cols-2 gap-6">
          {hasPhone && (
            <a href={`tel:${site.contact.phoneE164}`} class="block bg-white border border-cream-deep rounded-2xl p-6 shadow-card hover:shadow-soft transition-shadow">
              <div class="text-xs uppercase tracking-widest2 text-bark">Call</div>
              <div class="mt-2 font-display text-2xl text-forest">{site.contact.phoneDisplay}</div>
              <p class="mt-3 text-sm text-ink-muted">Fastest for actively dangerous situations. Goes to voicemail outside hours; we call back within the next business morning.</p>
            </a>
          )}

          {hasPhone && (
            <a href={`sms:${site.contact.phoneE164}`} class="block bg-white border border-cream-deep rounded-2xl p-6 shadow-card hover:shadow-soft transition-shadow">
              <div class="text-xs uppercase tracking-widest2 text-bark">Text</div>
              <div class="mt-2 font-display text-2xl text-forest">{site.contact.phoneDisplay}</div>
              <p class="mt-3 text-sm text-ink-muted">Send a photo of the tree, your address, and what you are thinking. We will reply with a ballpark.</p>
            </a>
          )}

          {hasEmail && (
            <div class={`bg-white border border-cream-deep rounded-2xl p-6 shadow-card ${hasPhone ? 'sm:col-span-2' : ''}`}>
              <div class="text-xs uppercase tracking-widest2 text-bark">Email</div>
              <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-3">
                <a href={`mailto:${site.contact.email}`} class="font-display text-2xl text-forest hover:text-forest-dark transition-colors break-all">{site.contact.email}</a>
                <button type="button" id="copy-email" data-email={site.contact.email} aria-label="Copy email address to clipboard"
                  class="copy-email-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-moss/60 text-sm font-medium text-forest hover:bg-cream-dark transition-colors shrink-0">
                  <svg class="copy-icon w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                  <span class="copy-label">Copy</span>
                </button>
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="mt-10 bg-white border border-cream-deep rounded-2xl p-8 shadow-card">
          <p class="text-ink leading-relaxed">
            Tarzan Trimming is opening for residential pruning and limb removal across south Ontario shortly. Phone, text, and email channels are being set up. Bookmark this page, or check back in a few days.
          </p>
        </div>
      )}

      <div class="mt-12 bg-cream-dark rounded-2xl p-6">
        <h2 class="font-display text-xl text-forest mb-3">Service area</h2>
        <p class="text-ink leading-relaxed">{site.brand.shortDescription}</p>
        <p class="mt-3 text-sm text-ink-muted">{site.hours.label}</p>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <script>
    const copyBtn = document.getElementById('copy-email');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || '';
        try {
          await navigator.clipboard.writeText(email);
        } catch (e) {
          const ta = document.createElement('textarea');
          ta.value = email;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.focus();
          ta.select();
          try { document.execCommand('copy'); } catch (_) { /* no-op */ }
          ta.remove();
        }
        const label = copyBtn.querySelector('.copy-label');
        if (!label) return;
        const original = label.textContent;
        label.textContent = 'Copied!';
        copyBtn.classList.add('bg-forest', 'text-cream', 'border-forest');
        copyBtn.classList.remove('text-forest');
        window.setTimeout(() => {
          label.textContent = original;
          copyBtn.classList.remove('bg-forest', 'text-cream', 'border-forest');
          copyBtn.classList.add('text-forest');
        }, 1800);
      });
    }
  </script>
</BaseLayout>
