---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ProblemPromise from '~/components/ProblemPromise.astro';
import MiniAbout from '~/components/MiniAbout.astro';
import ServicesGrid from '~/components/ServicesGrid.astro';
import PhotoGallery from '~/components/PhotoGallery.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import site from '~/data/site.json';
import services from '~/data/services.json';
import faqData from '~/data/faq.json';

const offeredServices = services.services.filter(s => !s.comingSoon);

const title = `${site.brand.name} · Tree Pruning & Limb Removal, South Ontario`;
---
<BaseLayout title={title} description="Owner-led tree pruning and limb removal across south Ontario. Honest quotes, clean work, no high-pressure pitch. Book a free on-site estimate." path="/">
  <Hero />
  <ProblemPromise />
  <MiniAbout />
  <ServicesGrid />
  <PhotoGallery />
  <FAQ />
  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": new URL('/#business', Astro.site).toString(),
    "name": site.brand.name,
    "description": site.brand.fullDescription,
    "url": Astro.site?.toString(),
    "image": new URL('/photos/og-default.png', Astro.site).toString(),
    "logo": new URL('/photos/og-default.png', Astro.site).toString(),
    ...(site.contact.phoneE164 ? { "telephone": site.contact.phoneE164 } : {}),
    "areaServed": site.serviceCities.map(c => ({ "@type": "City", "name": c.name })),
    "address": {
      "@type": "PostalAddress",
      "addressRegion": site.location.province,
      "addressCountry": "CA"
    },
    "priceRange": "$$",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Tree care services",
      "itemListElement": offeredServices.map(s => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": s.name,
          "serviceType": s.name,
          "url": new URL('/services/' + s.slug + '/', Astro.site).toString(),
          "areaServed": site.serviceCities.map(c => ({ "@type": "City", "name": c.name }))
        }
      }))
    }
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqData.items.map(item => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.a
      }
    }))
  })} />
</BaseLayout>
