---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import ProblemPromise from '~/components/ProblemPromise.astro';
import MiniAbout from '~/components/MiniAbout.astro';
import ServicesGrid from '~/components/ServicesGrid.astro';
import PhotoGallery from '~/components/PhotoGallery.astro';
import FAQ from '~/components/FAQ.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import site from '~/data/site.json';

const title = `${site.brand.name} · Tree Pruning and Limb Removal in South Ontario`;
---
<BaseLayout title={title} path="/">
  <Hero />
  <ProblemPromise />
  <MiniAbout />
  <ServicesGrid />
  <PhotoGallery />
  <FAQ />
  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": site.brand.name,
    "description": site.brand.fullDescription,
    "url": Astro.site?.toString(),
    "telephone": site.contact.phoneE164,
    "areaServed": site.serviceCities.map(c => ({ "@type": "City", "name": c.name })),
    "address": {
      "@type": "PostalAddress",
      "addressRegion": site.location.province,
      "addressCountry": "CA"
    },
    "priceRange": "$$"
  })} />
</BaseLayout>
