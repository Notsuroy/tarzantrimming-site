---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import servicesData from '~/data/services.json';
import site from '~/data/site.json';

const services = servicesData.services;
const title = `Services · ${site.brand.name}`;

// The services hub was the only content page on the site emitting no entity
// schema at all: just a BreadcrumbList, no tie to the LocalBusiness graph and
// no machine-readable list of what we actually offer. Every other hub carries
// one (/blog/ has Blog, /service-areas/ has Service + LocalBusiness), and this
// is the money hub. Property set is mirrored verbatim from the already-shipped
// per-service page schema in services/[slug].astro, so nothing here is a new
// or unvalidated property.
//
// "Coming soon" services are excluded on purpose, same rule the leaf pages
// follow: we do not publish structured data claiming work we do not do yet.
const offeredServices = services.filter((s) => !s.comingSoon);
const areaServed = site.serviceCities.map((c) => ({ '@type': 'City', name: c.name }));
const provider = {
  '@type': 'LocalBusiness',
  name: site.brand.name,
  url: site.url,
  areaServed: site.location.serviceAreaLabel,
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Services · ${site.brand.name}`,
  description:
    'Tree pruning and limb removal across south Ontario, done properly by an owner-led crew.',
  url: new URL('/services/', Astro.site).toString(),
  inLanguage: 'en-CA',
  about: provider,
  mainEntity: {
    '@type': 'ItemList',
    name: 'Tree care services',
    numberOfItems: offeredServices.length,
    itemListElement: offeredServices.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.name,
      url: new URL(`/services/${s.slug}/`, Astro.site).toString(),
      item: {
        '@type': 'Service',
        name: s.name,
        serviceType: s.name,
        description: s.shortDescription,
        areaServed,
        provider,
        url: new URL(`/services/${s.slug}/`, Astro.site).toString(),
      },
    })),
  },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
  ],
};
---
<BaseLayout title={title} description="Tree pruning and limb removal across south Ontario, done properly by an owner-led crew. See how each service works and book a free estimate." path="/services/">
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs uppercase tracking-widest2 text-ink-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-forest">Home</a>
        <span class="mx-2">/</span>
        <span class="text-forest">Services</span>
      </nav>
      <div class="max-w-narrow mb-12">
        <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Services</div>
        <h1 class="font-display text-4xl md:text-5xl text-forest leading-tight">Tree pruning and limb removal across south Ontario.</h1>
        <p class="mt-5 text-lg text-ink-muted leading-relaxed">Two services right now, done properly. Full removals queued for once the rig scales up.</p>
      </div>

      <div class="space-y-16">
        {services.map((s) => (
          <article id={s.slug} class={`grid md:grid-cols-3 gap-8 ${s.comingSoon ? 'opacity-70' : ''}`}>
            <div class="md:col-span-1">
              <h2 class="font-display text-3xl text-forest leading-tight">
                {s.comingSoon
                  ? s.name
                  : <a href={`/services/${s.slug}/`} class="hover:text-forest-dark underline decoration-moss/50 underline-offset-4">{s.name}</a>}
              </h2>
              <p class="mt-2 text-bark font-medium">{s.tagline}</p>
              <div class="mt-4 text-sm text-ink-muted">{s.priceRange}</div>
              {s.comingSoon
                ? <div class="mt-3 inline-block text-xs uppercase tracking-widest2 px-2 py-1 bg-bark/15 text-bark-dark rounded">Coming soon</div>
                : <a href={`/services/${s.slug}/`} class="mt-3 inline-block text-sm font-medium text-forest underline hover:text-forest-dark">Full details</a>}
            </div>

            <div class="md:col-span-2 space-y-6 text-ink leading-relaxed">
              <p set:html={s.description.replace(/\n\n/g, '</p><p>')}></p>
              {s.process.length > 0 && (
                <div>
                  <h3 class="font-display text-xl text-forest mb-3">How it works</h3>
                  <ol class="list-decimal pl-5 space-y-1 text-ink-muted">
                    {s.process.map((step) => <li>{step}</li>)}
                  </ol>
                </div>
              )}
              {s.goodFor.length > 0 && (
                <div>
                  <h3 class="font-display text-xl text-forest mb-3">Good for</h3>
                  <ul class="list-disc pl-5 space-y-1 text-ink-muted">
                    {s.goodFor.map((g) => <li>{g}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <FinalCTA />
  <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</BaseLayout>
