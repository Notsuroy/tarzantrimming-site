---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FinalCTA from '~/components/FinalCTA.astro';
import servicesData from '~/data/services.json';
import site from '~/data/site.json';

// Dedicated, indexable page per offered service. "Coming soon" services
// (full tree removal) are intentionally excluded: we do not publish a
// rankable page for work that is not actually offered yet.
export function getStaticPaths() {
  return servicesData.services
    .filter((s) => !s.comingSoon)
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const path = `/services/${service.slug}/`;

// Per-service H1 + meta description. Kept here (not in services.json) so the
// existing /services/ menu page rendering is untouched. H1 carries the focus
// keyword; meta descriptions are 140 to 155 chars with keyword plus region.
const seoMap: Record<string, { h1: string; metaDescription: string }> = {
  'tree-pruning': {
    h1: 'Tree Pruning in South Ontario',
    metaDescription:
      'Owner-led tree pruning across the Toronto to Kitchener corridor. Clean, intentional cuts that keep trees healthy. Honest quotes, free estimate.',
  },
  'limb-removal': {
    h1: 'Limb Removal in South Ontario',
    metaDescription:
      'Hanging or broken limb over your roof or driveway? Owner-led limb removal across south Ontario. Safe roped descents, fast turnaround, free quote.',
  },
};
const seo = seoMap[service.slug] ?? {
  h1: `${service.name} in South Ontario`,
  metaDescription: service.shortDescription,
};

// Per-service hero photo. The service pages (the money pages) previously
// carried no in-content imagery while every other page on the site has
// photos, which left the highest-intent pages visually thin and gave Google
// no image signal for them. These are existing licensed work photos already
// shipped in public/photos, mapped to the matching service. Decorative only:
// no claim about a specific job, certification, or guaranteed outcome.
// width/height match the intrinsic 800x800 so the browser reserves the box
// (CLS-safe), and object-cover crops to the fixed display height.
const heroMap: Record<string, { src: string; alt: string; width: number; height: number }> = {
  'tree-pruning': {
    src: '/photos/work-climb.webp',
    alt: 'Owner-led arborist roped into a mature tree making selective pruning cuts in south Ontario',
    width: 800,
    height: 800,
  },
  'limb-removal': {
    src: '/photos/work-limb.webp',
    alt: 'Arborist lowering a broken limb in controlled roped sections over a south Ontario yard',
    width: 800,
    height: 800,
  },
};
const hero = heroMap[service.slug] ?? null;

const title = `${service.name} in South Ontario · ${site.brand.name}`;

// Other offered services for cross-linking.
const related = servicesData.services.filter((s) => !s.comingSoon && s.slug !== service.slug);

const cities = site.serviceCities.map((c) => c.name);
const citiesText =
  cities.length > 1
    ? `${cities.slice(0, -1).join(', ')}, and ${cities[cities.length - 1]}`
    : cities[0];

const descParas = service.description.split('\n\n');
const seasonalNote = (service as any).seasonalNote as string | undefined;

// Contextual link into the pruning-timing guide. The guide previously had no
// in-content inbound links (it was reachable only from the global nav), which
// dilutes its internal ranking signal. The anchor below is slug-specific so it
// honestly matches the guide section each service relates to: pruning timing
// for tree-pruning, storm damage and hazard limbs for limb-removal.
const guideHref = '/guide/when-to-prune-trees-southern-ontario/';

// Reciprocal link edge into the per-city tree-permit guides. The three permit
// posts already link INTO the service pages; this closes the loop so the
// cluster links both ways (and routes removal-intent visitors who land on a
// service page to the bylaw explainer for their city). Honest framing only:
// Tarzan does pruning and limb removal, not full removal, and permits apply to
// REMOVING a protected tree, so the copy points there without claiming we do
// removals. Keep this list in lockstep with the live /blog/ permit posts.
const permitGuides = [
  { city: 'Toronto', href: '/blog/tree-removal-permit-toronto/' },
  { city: 'Mississauga', href: '/blog/tree-removal-permit-mississauga/' },
  { city: 'Oakville', href: '/blog/tree-removal-permit-oakville/' },
  { city: 'Burlington', href: '/blog/tree-removal-permit-burlington/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: service.shortDescription,
  areaServed: site.serviceCities.map((c) => ({ '@type': 'City', name: c.name })),
  provider: {
    '@type': 'LocalBusiness',
    name: site.brand.name,
    url: site.url,
    areaServed: site.location.serviceAreaLabel,
  },
  url: new URL(path, Astro.site).toString(),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Services', item: new URL('/services/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: service.name, item: new URL(path, Astro.site).toString() },
  ],
};

// Per-service FAQs. One array drives BOTH the visible accordion and the
// FAQPage JSON-LD, so schema and visible content stay in lockstep (Google
// requires the answer text to be present on the page). Answers are honest and
// owner-led: no certification claims, no 24/7 framing, quote-only pricing,
// horticultural guidance that is general best practice (not site-specific
// assertions). Copy mirrors language already published in services.json.
const faqMap: Record<string, { q: string; a: string }[]> = {
  'tree-pruning': [
    {
      q: 'When is the best time to prune trees in south Ontario?',
      a: 'Most deciduous trees prune best in late winter, roughly February into early March, while they are dormant and before the spring flush of growth. Dead or hazardous limbs can come off any time of year. We avoid heavy pruning on oaks from April through July to reduce oak wilt risk, so those cuts are timed for the dormant season.',
    },
    {
      q: 'How much does tree pruning cost?',
      a: 'Pricing is per tree and per job, quoted after a free on-site look. A small ornamental is very different from a mature maple over the house, so we will not give a real number without seeing the work. There is no deposit to get a quote and no pressure to book on the spot.',
    },
    {
      q: 'Will pruning hurt my tree?',
      a: 'Done right, no. Each cut is intentional and made at the branch collar so the tree can seal the wound naturally, and we use a three-cut technique on larger limbs so the bark does not tear. We do not top trees or strip more live canopy than is healthy in a single visit.',
    },
    {
      q: 'How much of a tree can be safely pruned at once?',
      a: 'As a rule we keep live-growth removal modest in any one season, usually around a quarter of the canopy at most, so the tree is not stressed. Dead and broken wood does not count toward that, since taking it off only helps. If a tree needs more work than that, we stage it across visits.',
    },
    {
      q: 'Do you clean up after the job?',
      a: 'Yes. Debris is chipped on site or hauled away, whichever you prefer, and you get a clean yard when we leave. Tarzan Trimming is owner-led and works by appointment on evenings and weekends.',
    },
  ],
  'limb-removal': [
    {
      q: 'What is the difference between limb removal and full tree removal?',
      a: 'Limb removal takes off one or a few problem branches while the tree stays standing. Full tree removal takes the whole tree down. If the tree is fundamentally healthy and only a limb or two is the issue, limb removal is the lighter job, since the tree stays put and only the problem branches come off. Full tree removal is not something we offer yet.',
    },
    {
      q: 'How quickly can you remove a hanging or broken limb?',
      a: 'Most limb removals are a same-day or next-evening job, depending on the week and the rigging involved. Send a photo through the contact page and we will tell you straight how soon we can get to it. We are owner-led and work evenings and weekends, so this is not a middle-of-the-night emergency service.',
    },
    {
      q: 'Can you take down a limb hanging over my roof or driveway?',
      a: 'Yes. Limbs over a structure are roped and lowered in controlled sections so the wood never drops on anything below. That careful rigging over roofs, decks, and driveways is exactly the kind of work we focus on.',
    },
    {
      q: 'Do you remove limbs near power lines?',
      a: 'Limbs on or close to the primary lines are a hydro safety matter, not a job for a tree crew. If wood is touching the lines running to your house, call your local hydro provider first. We handle limbs that are well clear of the lines.',
    },
    {
      q: 'How much does limb removal cost?',
      a: 'Quoted per job after a free look, since a single low limb is very different from a large dead leader high in the crown. No deposit to get a number, and if the honest answer is that the limb can wait, we will tell you that too.',
    },
  ],
};
const faqs = faqMap[service.slug] ?? [];

const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<BaseLayout title={title} description={seo.metaDescription} path={path}>
  <section class="py-16 md:py-24 bg-cream">
    <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-xs uppercase tracking-widest2 text-ink-muted mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-forest">Home</a>
        <span class="mx-2">/</span>
        <a href="/services/" class="hover:text-forest">Services</a>
        <span class="mx-2">/</span>
        <span class="text-forest">{service.name}</span>
      </nav>

      <div class="max-w-narrow mb-12">
        <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Service</div>
        <h1 class="font-display text-4xl md:text-5xl text-forest leading-tight">{seo.h1}</h1>
        <p class="mt-4 text-bark font-medium text-lg">{service.tagline}</p>
        <p class="mt-4 text-lg text-ink-muted leading-relaxed">{service.shortDescription}</p>
      </div>

      {hero && (
        <div class="mb-12">
          <img
            src={hero.src}
            alt={hero.alt}
            width={hero.width}
            height={hero.height}
            loading="eager"
            decoding="async"
            class="w-full h-64 md:h-96 object-cover rounded-2xl border border-moss/40"
          />
        </div>
      )}

      <div class="grid md:grid-cols-3 gap-10">
        <div class="md:col-span-2 space-y-10 text-ink leading-relaxed">
          <div class="space-y-5">
            {descParas.map((p) => <p>{p}</p>)}
          </div>

          {service.process.length > 0 && (
            <div>
              <h2 class="font-display text-2xl text-forest mb-4">How it works</h2>
              <ol class="list-decimal pl-5 space-y-2 text-ink-muted">
                {service.process.map((step) => <li>{step}</li>)}
              </ol>
            </div>
          )}

          {service.goodFor.length > 0 && (
            <div>
              <h2 class="font-display text-2xl text-forest mb-4">Good for</h2>
              <ul class="list-disc pl-5 space-y-2 text-ink-muted">
                {service.goodFor.map((g) => <li>{g}</li>)}
              </ul>
            </div>
          )}

          {seasonalNote && (
            <div>
              <h2 class="font-display text-2xl text-forest mb-4">When to do this work</h2>
              <p class="text-ink-muted">{seasonalNote}</p>
              {service.slug === 'tree-pruning' && (
                <p class="text-ink-muted mt-3">
                  For the full seasonal breakdown, see our
                  <a href={guideHref} class="text-forest underline hover:text-forest-dark"> guide on when to prune trees in southern Ontario</a>,
                  which covers the dormant season, sap bleeders like maple and birch, and oak wilt timing.
                </p>
              )}
              {service.slug === 'limb-removal' && (
                <p class="text-ink-muted mt-3">
                  Dealing with a limb after a storm? Our
                  <a href={guideHref} class="text-forest underline hover:text-forest-dark"> guide on when to prune trees in southern Ontario</a>
                  also walks through storm damage and the signs a limb may need to come down.
                </p>
              )}
            </div>
          )}

          <div>
            <h2 class="font-display text-2xl text-forest mb-4">Where we work</h2>
            <p class="text-ink-muted">
              Tarzan Trimming is mobile and owner-led, covering {citiesText}. We are
              <a href="/about/" class="text-forest underline hover:text-forest-dark"> a small operation by design</a>,
              so every job gets the same attention. See the full
              <a href="/services/" class="text-forest underline hover:text-forest-dark"> service menu</a>
              if you are weighing options.
            </p>
          </div>

          <div>
            <h2 class="font-display text-2xl text-forest mb-4">Removing a protected tree? Check the permit rules first</h2>
            <p class="text-ink-muted">
              Across the GTA corridor most cities protect larger private trees, and you usually need a
              permit, often with an arborist report, before a protected tree comes down. We focus on
              pruning and limb removal rather than full removals, but if you are weighing whether a tree
              should come out, it pays to know your city's bylaw before you start. We have written
              plain-language guides for
              {permitGuides.map((g, i) => (
                <>{i > 0 && (i === permitGuides.length - 1 ? ', and ' : ', ')}<a href={g.href} class="text-forest underline hover:text-forest-dark">{g.city}</a></>
              ))}.
            </p>
          </div>

          <div>
            <h2 class="font-display text-2xl text-forest mb-4">What it costs</h2>
            <p class="text-ink-muted">
              <strong class="text-ink">{service.priceRange}.</strong> Pricing is per tree and per job,
              quoted after a free look at the work. No deposit to get a number, and no pressure to book on
              the spot. If the honest answer is that the work can wait, we will tell you that too.
            </p>
          </div>

          {related.length > 0 && (
            <div class="pt-2">
              <h2 class="font-display text-2xl text-forest mb-4">Related service</h2>
              <ul class="space-y-2">
                {related.map((r) => (
                  <li>
                    <a href={`/services/${r.slug}/`} class="text-forest underline hover:text-forest-dark font-medium">{r.name}</a>
                    <span class="text-ink-muted"> {r.tagline}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <p class="text-ink-muted">
            Not sure whether you need {service.name.toLowerCase()} or something else? Send a photo through the
            <a href="/contact/" class="text-forest underline hover:text-forest-dark"> contact page</a>
            and we will tell you straight. You can also start back at the
            <a href="/" class="text-forest underline hover:text-forest-dark"> home page</a>
            for an overview of how Tarzan Trimming works.
          </p>
        </div>

        <aside class="md:col-span-1">
          <div class="bg-white rounded-2xl border border-moss/40 p-6 sticky top-24">
            <div class="text-xs uppercase tracking-widest2 text-forest mb-2">Tarzan Trimming</div>
            <p class="text-ink-muted text-sm leading-relaxed">
              Owner-led tree care across south Ontario. By appointment, evenings and weekends. Honest quotes,
              clean work, no high-pressure pitch.
            </p>
            <a href="/contact/" class="mt-5 inline-flex items-center px-4 py-2 bg-forest text-cream rounded-full text-sm font-medium hover:bg-forest-dark transition-colors">
              Ask for a quote
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="py-16 md:py-24 bg-white" id="faq">
      <div class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-narrow mx-auto text-center mb-12">
          <div class="text-xs uppercase tracking-widest2 text-forest mb-3">Common questions</div>
          <h2 class="font-display text-3xl md:text-4xl text-forest leading-tight">{`Questions about ${service.name.toLowerCase()}.`}</h2>
        </div>

        <div class="max-w-narrow mx-auto space-y-3">
          {faqs.map((item) => (
            <details class="group bg-cream border border-cream-deep rounded-xl open:shadow-card transition-shadow">
              <summary class="cursor-pointer list-none px-6 py-5 flex items-start justify-between gap-4 font-medium text-ink">
                <span>{item.q}</span>
                <span class="text-forest text-2xl leading-none group-open:rotate-45 transition-transform shrink-0">+</span>
              </summary>
              <div class="px-6 pb-5 text-ink-muted leading-relaxed">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <FinalCTA />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</BaseLayout>
